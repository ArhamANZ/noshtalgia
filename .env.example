# Supabase Public Keys
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase Server-Side Secret Key (Required for messages and airmail tables)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Session Secret (Optional - defaults to built-in fallback)
AIRMAIL_SESSION_SECRET="your-custom-session-secret"
